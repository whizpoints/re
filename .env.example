# ==============================================================================
# WHIZPOINT FLIPBOOK — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual production/development credentials.
# Never commit your actual .env file with secrets to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# In development: http://localhost:3000
# In production: https://e.whizpoint.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (Port 6543 / PgBouncer):
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require&pgbouncer=true&channel_binding=require"

# Direct connection string for Prisma migrations (Port 5432):
DIRECT_URL="postgresql://neondb_owner:[PASSWORD]@[HOST].[REGION].aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION (Cloudflare R2)
# ------------------------------------------------------------------------------
S3_REGION="auto"
S3_ENDPOINT="https://[YOUR_CLOUDFLARE_ACCOUNT_ID].r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="[YOUR_R2_ACCESS_KEY_ID]"
S3_SECRET_ACCESS_KEY="[YOUR_R2_SECRET_ACCESS_KEY]"
S3_BUCKET_NAME="whiz-pos-assets"
S3_PUBLIC_URL="https://r2.whizpoint.app"

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION SERVICE (Brevo SMTP)
# ------------------------------------------------------------------------------
BREVO_SMTP_SERVER="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_LOGIN="your-brevo-smtp-login@smtp-brevo.com"
BREVO_SMTP_KEY="xsmtpsib-[YOUR_BREVO_SMTP_KEY]"
BREVO_FROM_NAME="Whizpoint Flipbook"
BREVO_FROM_EMAIL="noreply@whizpoint.app"

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 (Google Single Sign-On)
# ------------------------------------------------------------------------------
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://e.whizpoint.app/api/auth/callback/google
GOOGLE_CLIENT_ID="[YOUR_GOOGLE_CLIENT_ID].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-[YOUR_GOOGLE_CLIENT_SECRET]"
